{
  "name": "tools-landing-page",
  "version": "1.0.0",
  "description": "Modern landing page for tools collection",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run watch:css\"",
    "watch:css": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --watch",
    "build:css": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css",
    "create:admin": "node scripts/createAdmin.js",
    "build:editor": "esbuild src/client/editor.js --bundle --outfile=public/js/editor.bundle.js",
    "tailwind:dev": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --watch",
    "tailwind:build": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --minify"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.3",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.30.7",
    "@editorjs/embed": "^2.7.6",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.1",
    "@editorjs/inline-code": "^1.5.1",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.2",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/paragraph": "^2.11.7",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.3",
    "@editorjs/underline": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.6",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.19.5",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17"
  }
}
