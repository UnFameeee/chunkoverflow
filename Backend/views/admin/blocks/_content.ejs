<div class="mb-8 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-800">Manage Tools</h1>
    <button onclick="document.getElementById('createBlockModal').classList.remove('hidden')"
        class="bg-[#72d1a8] hover:bg-[#5bb892] text-white px-4 py-2 rounded-lg">
        Add New Tool
    </button>
    <% if (locals.message) { %>
        <div class="fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg <%= locals.messageType === 'error' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
            <%= message %>
        </div>
        <script>
            window.onload = function() {
                showToast('<%= message %>', '<%= locals.messageType || "success" %>');
                setTimeout(() => {
                    const toast = document.querySelector('.fixed.top-4.right-4');
                    if (toast) toast.style.display = 'none';
                }, 5000);
            }
        </script>
    <% } %>
</div>

<!-- Blocks Table -->
<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% blocks.forEach(block => { %>
                <tr class="<%= block.isArchived ? 'bg-gray-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <% if (block.iconPath) { %>
                                <img class="h-12 w-12 mr-3 object-contain" src="<%= block.iconPath %>" alt="<%= block.title %>">
                            <% } %>
                            <div class="text-sm font-medium text-gray-900"><%= block.title %></div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <% if (block.url) { %>
                            <a href="<%= block.url %>" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center text-[#72d1a8] hover:text-[#5bb892]">
                                <span class="text-sm">Visit URL</span>
                                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                </svg>
                            </a>
                        <% } else { %>
                            <span class="text-sm text-gray-500">No URL</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                            <%= block.status === 'PUBLISHED' ? 'bg-green-100 text-green-800' :
                                block.status === 'IN_DEVELOPMENT' ? 'bg-yellow-100 text-yellow-800' :
                                'bg-gray-100 text-gray-800' %>">
                            <%= block.status %>
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= new Date(block.createdAt).toLocaleDateString() %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <button 
                            onclick="editTool('<%= block.id %>')"
                            class="text-blue-600 hover:text-blue-800 mr-2">
                            Edit
                        </button>
                        <form action="/admin/blocks/<%= block.id %>/archive?_method=PATCH" method="POST" class="inline">
                            <button type="submit" class="text-yellow-600 hover:text-yellow-800 mr-3">
                                <%= block.isArchived ? 'Unarchive' : 'Archive' %>
                            </button>
                        </form>
                        <form action="/admin/blocks/<%= block.id %>?_method=DELETE" method="POST" class="inline">
                            <button type="submit" 
                                onclick="confirmDelete(event)"
                                class="text-red-600 hover:text-red-800">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Create Block Modal -->
<div id="createBlockModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800">Create New Block</h2>
            <button onclick="document.getElementById('createBlockModal').classList.add('hidden')"
                class="text-gray-600 hover:text-gray-800">&times;</button>
        </div>
        <div class="overflow-y-auto flex-1 pr-2">
            <form id="createForm" action="/admin/blocks" method="POST" enctype="multipart/form-data">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="title">Title</label>
                    <input type="text" id="title" name="title" required
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="summaryDescription">
                        Summary Description
                    </label>
                    <input type="hidden" id="summaryDescription" name="summaryDescription">
                    <div id="createSummaryEditor" class="border rounded"></div>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="fullDescription">
                        Full Description
                        <span class="text-sm font-normal text-gray-500">(Block-style editor)</span>
                    </label>
                    <input type="hidden" id="fullDescription" name="fullDescription">
                    <div id="createFullEditor" class="border rounded"></div>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="url">Tool URL</label>
                    <input type="url" id="url" name="url" 
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700"
                        placeholder="https://...">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="icon">Icon</label>
                    <input type="file" id="icon" name="icon" accept="image/*"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                </div>
                <div class="mb-6">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="status">Status</label>
                    <select id="status" name="status" required
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                        <option value="PENDING">Pending</option>
                        <option value="IN_DEVELOPMENT">In Development</option>
                        <option value="PUBLISHED">Published</option>
                    </select>
                </div>
                <div class="flex justify-end">
                    <button type="button" 
                        onclick="document.getElementById('createBlockModal').classList.add('hidden')"
                        class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded mr-2">
                        Cancel
                    </button>
                    <button type="submit"
                        class="bg-[#72d1a8] hover:bg-[#5bb892] text-white font-bold py-2 px-4 rounded">
                        Create Block
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Load Tools từ CDN -->
<script src="https://cdn.jsdelivr.net/npm/@editorjs/editorjs@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/header@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/paragraph@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/delimiter@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/nested-list@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/quote@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/code@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/marker@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/inline-code@latest"></script>

<script>
// Get tool classes from global scope
const tools = {
    header: window.Header,
    paragraph: window.Paragraph,
    list: window.NestedList,
    delimiter: window.Delimiter,
    quote: window.Quote,
    code: window.CodeTool,
    marker: window.Marker,
    inlineCode: window.InlineCode
};

const EditorManager = {
    createEditor(config) {
        const defaultConfig = {
            tools: {
                header: tools.header,
                paragraph: tools.paragraph,
                list: tools.list,
                delimiter: tools.delimiter,
                quote: tools.quote,
                code: tools.code,
                marker: tools.marker,
                inlineCode: tools.inlineCode
            },
            placeholder: 'Type something...',
            inlineToolbar: ['bold', 'italic', 'marker', 'inlineCode'],
            data: {
                blocks: [{
                    type: 'paragraph',
                    data: { text: '' }
                }]
            }
        };

        return new EditorJS({
            ...defaultConfig,
            ...config,
            tools: {
                ...defaultConfig.tools,
                ...(config.tools || {})
            }
        });
    },

    async destroyEditor(editor) {
        if (editor && typeof editor.destroy === 'function') {
            try {
                await editor.destroy();
            } catch (error) {
                console.error('Error destroying editor:', error);
            }
        }
        return null;
    }
};

window.EditorManager = EditorManager;

let createFullEditor, createSummaryEditor;
    
    // Function to initialize create form editors
    async function initializeCreateEditors() {
        try {
            const fullConfig = {
                holder: 'createFullEditor',
                placeholder: 'Start typing...',
                defaultBlock: 'paragraph',
                autofocus: true,
                onChange: () => {
                    createFullEditor.save().then((outputData) => {
                        document.getElementById('fullDescription').value = JSON.stringify(outputData);
                    });
                }
            };
            
            const summaryConfig = {
                holder: 'createSummaryEditor',
                placeholder: 'Write a brief summary...',
                defaultBlock: 'paragraph',
                autofocus: false,
                minHeight: 100,
                onChange: () => {
                    createSummaryEditor.save().then((outputData) => {
                        document.getElementById('summaryDescription').value = JSON.stringify(outputData);
                    });
                }
            };

            createFullEditor = window.EditorManager.createEditor(fullConfig);
            createSummaryEditor = window.EditorManager.createEditor(summaryConfig);

            // Đợi cho editors sẵn sàng
            await Promise.all([
                createFullEditor.isReady,
                createSummaryEditor.isReady
            ]);

        } catch (error) {
            console.error('Error initializing editors:', error);
            throw error;
        }
    }
    
    // Function to destroy create form editors
    async function destroyCreateEditors() {
        createFullEditor = await window.EditorManager.destroyEditor(createFullEditor);
        createSummaryEditor = await window.EditorManager.destroyEditor(createSummaryEditor);
    }

    // Form validation for create form
    document.getElementById('createForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        try {
            // Kiểm tra xem editor có tồn tại không
            if (!createFullEditor || !createSummaryEditor) {
                throw new Error('Editors not initialized');
            }

            // Đợi cho editors sẵn sàng
            await Promise.all([
                createFullEditor.isReady,
                createSummaryEditor.isReady
            ]);

            const summaryData = await createSummaryEditor.save();
            const fullData = await createFullEditor.save();
            
            if (!summaryData.blocks.length) {
                alert('Please enter a summary description');
                return;
            }
            
            if (!fullData.blocks.length) {
                alert('Please enter a full description');
                return;
            }

            document.getElementById('summaryDescription').value = JSON.stringify(summaryData);
            document.getElementById('fullDescription').value = JSON.stringify(fullData);
            
            this.submit();
        } catch (error) {
            console.error('Editor validation failed:', error);
            showToast('Please ensure all editors are initialized and try again', 'error');
        }
    });

    // Initialize editors when create modal is opened
    document.querySelector('button[onclick*="createBlockModal"]').addEventListener('click', async () => {
        await destroyCreateEditors();
        // Add a small delay to ensure DOM is ready
        await new Promise(resolve => setTimeout(resolve, 100));
        try {
            await initializeCreateEditors();
        } catch (error) {
            console.error('Failed to initialize editors:', error);
            showToast('Failed to initialize editors', 'error');
        }
    });

    // Clean up editors when create modal is closed
    document.querySelector('#createBlockModal button[onclick*="classList.add"]').addEventListener('click', async () => {
        try {
            await destroyCreateEditors();
        } catch (error) {
            console.error('Failed to destroy editors:', error);
        }
    });
</script> 