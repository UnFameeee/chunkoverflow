{
  "name": "tools-landing-page",
  "version": "1.0.0",
  "description": "Modern landing page for tools collection",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run watch:css\"",
    "watch:css": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --watch",
    "build:css": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css",
    "create:admin": "node scripts/createAdmin.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.6",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17"
  }
}
