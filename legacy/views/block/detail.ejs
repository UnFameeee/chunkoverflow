<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= block.title %> - Tool Details</title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
</head>
<body class="bg-gray-50">
    <%- include('../partials/header') %>

    <main class="pt-32 pb-20">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <!-- Block Header -->
                <div class="mb-12 text-center" data-aos="fade-up">
                    <div class="w-20 h-20 bg-gradient-to-br from-[#72d1a8] to-[#4fa883] rounded-lg flex items-center justify-center mx-auto mb-6">
                        <% if (block.iconPath) { %>
                            <img src="<%= block.iconPath %>" alt="<%= block.title %>" class="w-12 h-12 text-white">
                        <% } else { %>
                            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                            </svg>
                        <% } %>
                    </div>
                    <h1 class="text-4xl font-bold text-gray-800 mb-4"><%= block.title %></h1>
                    <p class="text-xl text-gray-600"><%= block.summaryDescription %></p>
                    <% if (block.status === 'IN_DEVELOPMENT') { %>
                        <span class="inline-block mt-6 px-3 py-1 bg-yellow-100 text-yellow-800 text-sm font-semibold rounded-full">
                            In Development
                        </span>
                    <% } %>
                </div>

                <!-- Block Content -->
                <div class="bg-white rounded-xl shadow-lg p-8 mb-12" data-aos="fade-up" data-aos-delay="100">
                    <div class="prose max-w-none">
                        <%= block.fullDescription %>
                    </div>
                </div>

                <!-- Back Button -->
                <div class="text-center" data-aos="fade-up" data-aos-delay="200">
                    <a href="/" class="text-[#72d1a8] hover:text-[#5bb892] font-medium">
                        &larr; Back to Home
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
        });
    </script>
</body>
</html> 