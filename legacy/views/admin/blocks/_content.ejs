<div class="mb-8 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-800">Manage Tools</h1>
    <button onclick="document.getElementById('createBlockModal').classList.remove('hidden')"
        class="bg-[#72d1a8] hover:bg-[#5bb892] text-white px-4 py-2 rounded-lg">
        Add New Tool
    </button>
    <% if (locals.message) { %>
        <script>
            window.onload = function() {
                showToast('<%= message %>', '<%= locals.messageType || "success" %>');
            }
        </script>
    <% } %>
</div>

<!-- Blocks Table -->
<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% blocks.forEach(block => { %>
                <tr class="<%= block.isArchived ? 'bg-gray-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <% if (block.iconPath) { %>
                                <img class="h-12 w-12 mr-3 object-contain" src="<%= block.iconPath %>" alt="<%= block.title %>">
                            <% } %>
                            <div class="text-sm font-medium text-gray-900"><%= block.title %></div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <% if (block.url) { %>
                            <a href="<%= block.url %>" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center text-[#72d1a8] hover:text-[#5bb892]">
                                <span class="text-sm">Visit URL</span>
                                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                </svg>
                            </a>
                        <% } else { %>
                            <span class="text-sm text-gray-500">No URL</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                            <%= block.status === 'PUBLISHED' ? 'bg-green-100 text-green-800' :
                                block.status === 'IN_DEVELOPMENT' ? 'bg-yellow-100 text-yellow-800' :
                                'bg-gray-100 text-gray-800' %>">
                            <%= block.status %>
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= new Date(block.createdAt).toLocaleDateString() %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <button 
                            onclick="editTool('<%= block.id %>')"
                            class="text-blue-600 hover:text-blue-800 mr-2">
                            Edit
                        </button>
                        <form action="/admin/blocks/<%= block.id %>/archive?_method=PATCH" method="POST" class="inline">
                            <button type="submit" class="text-yellow-600 hover:text-yellow-800 mr-3">
                                <%= block.isArchived ? 'Unarchive' : 'Archive' %>
                            </button>
                        </form>
                        <form action="/admin/blocks/<%= block.id %>?_method=DELETE" method="POST" class="inline">
                            <button type="submit" 
                                onclick="confirmDelete(event)"
                                class="text-red-600 hover:text-red-800">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Create Block Modal -->
<div id="createBlockModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800">Create New Block</h2>
            <button onclick="document.getElementById('createBlockModal').classList.add('hidden')"
                class="text-gray-600 hover:text-gray-800">&times;</button>
        </div>
        <form action="/admin/blocks" method="POST" enctype="multipart/form-data">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="title">Title</label>
                <input type="text" id="title" name="title" required
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
            </div>
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="summaryDescription">
                    Summary Description
                </label>
                <textarea id="summaryDescription" name="summaryDescription" required
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 h-20"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="fullDescription">
                    Full Description
                </label>
                <textarea id="fullDescription" name="fullDescription"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="url">Tool URL</label>
                <input type="url" id="url" name="url" 
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700"
                    placeholder="https://...">
            </div>
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="icon">Icon</label>
                <input type="file" id="icon" name="icon" accept="image/*"
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
            </div>
            <div class="mb-6">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="status">Status</label>
                <select id="status" name="status" required
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                    <option value="PENDING">Pending</option>
                    <option value="IN_DEVELOPMENT">In Development</option>
                    <option value="PUBLISHED">Published</option>
                </select>
            </div>
            <div class="flex justify-end">
                <button type="button" 
                    onclick="document.getElementById('createBlockModal').classList.add('hidden')"
                    class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded mr-2">
                    Cancel
                </button>
                <button type="submit"
                    class="bg-[#72d1a8] hover:bg-[#5bb892] text-white font-bold py-2 px-4 rounded">
                    Create Block
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        EditorManager.initEditor('#fullDescription');
        EditorManager.initSummaryEditor('#summaryDescription');
    });
</script> 