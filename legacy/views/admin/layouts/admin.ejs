<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - <%= title %></title>
    <link href="/css/output.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/40.0.0/classic/ckeditor.js"></script>
    <script src="/js/editor.js"></script>
</head>
<body class="bg-gray-100">
    <!-- Admin Header -->
    <header class="bg-white shadow-md">
        <div class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <a href="/admin/blocks" class="flex items-center space-x-2">
                        <div class="w-8 h-8 bg-[#72d1a8] rounded-lg flex items-center justify-center">
                            <span class="text-white text-sm font-bold">C</span>
                        </div>
                        <span class="text-xl font-bold text-gray-800">Tools Admin</span>
                    </a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/" class="text-gray-600 hover:text-[#72d1a8]" target="_blank">View Site</a>
                    <a href="#" onclick="handleLogout()" class="text-red-600 hover:text-red-800">Logout</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Admin Content -->
    <main class="container mx-auto px-6 py-8">
        <%- locals.body || '' %>
    </main>

    <script src="/js/admin.js"></script>
    <script>
        // Add any admin-specific JavaScript here
        function confirmDelete(event) {
            if (!confirm('Are you sure you want to delete this item?')) {
                event.preventDefault();
            }
        }
    </script>
</body>
</html> 