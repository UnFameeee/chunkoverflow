<%- include('../layouts/admin', { body: include('./_content') }) %> 

<!-- Edit Block Modal -->
<div id="editBlockModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-lg p-8 max-w-2xl w-full max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800">Edit Tool</h2>
            <button onclick="document.getElementById('editBlockModal').classList.add('hidden')"
                class="text-gray-600 hover:text-gray-800">&times;</button>
        </div>
        <div class="overflow-y-auto flex-1 pr-2">
            <form id="editForm" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_method" value="PUT">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editTitle">Title</label>
                    <input type="text" id="editTitle" name="title" required
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editSummaryDescription">
                        Summary Description
                    </label>
                    <input type="hidden" id="editSummaryDescription" name="summaryDescription">
                    <div id="editSummaryEditor" class="border rounded"></div>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editFullDescription">
                        Full Description
                        <span class="text-sm font-normal text-gray-500">(Block-style editor)</span>
                    </label>
                    <input type="hidden" id="editFullDescription" name="fullDescription">
                    <div id="editFullEditor" class="border rounded"></div>
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editIcon">Icion</label>
                    <input type="file" id="editIcon" name="icon" accept="image/*"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                </div>
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editUrl">Tool URL</label>
                    <input type="url" id="editUrl" name="url" 
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700"
                        placeholder="https://...">
                </div>
                <div class="mb-6">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="editStatus">Status</label>
                    <select id="editStatus" name="status" required class="status-select"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                        <option value="PENDING">Pending</option>
                        <option value="IN_DEVELOPMENT">In Development</option>
                        <option value="PUBLISHED">Published</option>
                    </select>
                </div>
                <div class="flex justify-end">
                    <button type="button"
                        onclick="document.getElementById('editBlockModal').classList.add('hidden')"
                        class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded mr-2">
                        Cancel
                    </button>
                    <button type="submit"
                        class="bg-[#72d1a8] hover:bg-[#5bb892] text-white font-bold py-2 px-4 rounded">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let fullEditor, summaryEditor;
    
    // Function to initialize editors
    function initializeEditors() {
        try {
            const fullConfig = {
                ...window.EditorConfig.fullEditorConfig,
                holder: 'editFullEditor',
                data: {
                    blocks: [
                        {
                            type: 'paragraph',
                            data: {
                                text: ''
                            }
                        }
                    ]
                },
                onChange: () => {
                    fullEditor.save().then((outputData) => {
                        document.getElementById('editFullDescription').value = JSON.stringify(outputData);
                    });
                }
            };
            
            const summaryConfig = {
                ...window.EditorConfig.summaryEditorConfig,
                holder: 'editSummaryEditor',
                data: {
                    blocks: [
                        {
                            type: 'paragraph',
                            data: {
                                text: ''
                            }
                        }
                    ]
                },
                onChange: () => {
                    summaryEditor.save().then((outputData) => {
                        document.getElementById('editSummaryDescription').value = JSON.stringify(outputData);
                    });
                }
            };
            
            Promise.all([
                new window.EditorJS(fullConfig),
                new window.EditorJS(summaryConfig)
            ]).then(([full, summary]) => {
                fullEditor = full;
                summaryEditor = summary;
            }).catch(error => {
                console.error('Error initializing editors:', error);
            });
        } catch (error) {
            console.error('Error initializing editors:', error);
        }
    }
    
    // Function to destroy editors
    async function destroyEditors() {
        if (fullEditor) {
            await fullEditor.destroy();
            fullEditor = null;
        }
        if (summaryEditor) {
            await summaryEditor.destroy();
            summaryEditor = null;
        }
    }

    // Edit tool handler
    window.editTool = async function(id) {
        try {
            const response = await axios.get(`/admin/blocks/${id}`);
            const tool = response.data;
            
            // Show modal first
            const modal = document.getElementById('editBlockModal');
            modal.classList.remove('hidden');
            
            // Wait for modal to be visible
            await new Promise(resolve => setTimeout(resolve, 100));
            
            // Initialize editors
            await destroyEditors();
            initializeEditors();
            
            // Wait for editors to be ready
            await Promise.all([
                fullEditor.isReady,
                summaryEditor.isReady
            ]);
            
            // Populate form fields
            document.getElementById('editTitle').value = tool.title;
            
            // Clear existing blocks
            await fullEditor.blocks.clear();
            await summaryEditor.blocks.clear();
            
            // Add initial blocks
            if (tool.summaryDescription) {
                try {
                    const summaryData = JSON.parse(tool.summaryDescription);
                    if (summaryData.blocks) {
                        for (const block of summaryData.blocks) {
                            await summaryEditor.blocks.insert(block.type, block.data);
                        }
                    }
                } catch (e) {
                    await summaryEditor.blocks.insert('paragraph', {
                        text: tool.summaryDescription || ''
                    });
                }
            }
            
            if (tool.fullDescription) {
                try {
                    const fullData = JSON.parse(tool.fullDescription);
                    if (fullData.blocks) {
                        for (const block of fullData.blocks) {
                            await fullEditor.blocks.insert(block.type, block.data);
                        }
                    }
                } catch (e) {
                    await fullEditor.blocks.insert('paragraph', {
                        text: tool.fullDescription || ''
                    });
                }
            }
            
            document.getElementById('editStatus').value = tool.status;
            document.getElementById('editUrl').value = tool.url || '';
            
            // Update form action
            const form = document.getElementById('editForm');
            form.action = `/admin/blocks/${id}?_method=PUT`;
        } catch (error) {
            console.error('Error fetching tool:', error);
            showToast('Error loading tool details', 'error');
        }
    };

    // Form validation
    document.getElementById('editForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        try {
            const summaryData = await summaryEditor.save();
            const fullData = await fullEditor.save();
            
            document.getElementById('editSummaryDescription').value = JSON.stringify(summaryData);
            document.getElementById('editFullDescription').value = JSON.stringify(fullData);
            
            this.submit();
        } catch (error) {
            console.error('Editor validation failed:', error);
            showToast('Please fill in all required fields', 'error');
        }
    });

    // Clean up editor when modal is closed
    document.querySelector('#editBlockModal button[onclick*="classList.add"]').addEventListener('click', async function() {
        await destroyEditors();
        document.getElementById('editBlockModal').classList.add('hidden');
    });
</script>